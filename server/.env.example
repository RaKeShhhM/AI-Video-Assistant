PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/ai-video-assistant

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Public URL of this server (used to build the callback URL the AI service calls back into)
SELF_URL=http://localhost:5000

# Where the Python AI microservice lives
AI_SERVICE_URL=http://localhost:8000

# Shared secret both services use to authenticate internal calls — must match
# AI_SERVICE_SECRET in ai-service/.env
INTERNAL_AI_SECRET=change_this_shared_secret

# Comma-separated list of allowed frontend origins (CORS + Socket.io)
CLIENT_ORIGIN=http://localhost:5173
