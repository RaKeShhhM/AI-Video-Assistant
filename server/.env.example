PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/ai-video-assistant

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Legacy setting; callbacks now use EXPRESS_INTERNAL_URL in ai-service/.env.
SELF_URL=http://localhost:5000

# Where the Python AI microservice lives
AI_SERVICE_URL=http://localhost:8000

# Shared secret both services use to authenticate internal calls — must match
# AI_SERVICE_SECRET in ai-service/.env
INTERNAL_AI_SECRET=change_this_shared_secret
# Replace with the same random 32+ character secret as AI_SERVICE_SECRET.

# Comma-separated list of allowed frontend origins (CORS + Socket.io)
CLIENT_ORIGIN=http://localhost:5173

# S3 resource policy (match MAX_UPLOAD_MB / MAX_MEDIA_SECONDS in the AI service)
MAX_UPLOAD_MB=100
MAX_MEDIA_SECONDS=1800
MAX_ACTIVE_JOBS_PER_USER=1
MAX_CONCURRENT_UPLOADS=3
DAILY_MEDIA_MINUTES=120
DAILY_QUESTIONS=100
# Set only to the known number of trusted reverse-proxy hops in your deployment.
TRUST_PROXY_HOPS=0
