MISTRAL_API_KEY=your_mistral_api_key
SARVAM_API_KEY=your_sarvam_api_key_optional
SARVAM_STT_MODEL=saaras:v2.5
WHISPER_MODEL=small
UPLOAD_DIR=storage/uploads
DOWNLOAD_DIR=storage/downloads
VECTOR_DB_DIR=storage/vector_db
# Must match INTERNAL_AI_SECRET in server/.env — authenticates calls between the two services
AI_SERVICE_SECRET=change_this_shared_secret
# Generate a random 32+ character secret and use the same value in server/.env.
# Callback origin is trusted deployment configuration, never supplied by a caller.
EXPRESS_INTERNAL_URL=http://localhost:5000
PORT=8000

# S3: bounded media and single-process inference concurrency
MAX_UPLOAD_MB=100
MAX_MEDIA_SECONDS=1800
MAX_AI_JOBS=1
MAX_AI_ASKS=2
